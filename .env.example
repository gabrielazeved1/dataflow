# postgres
POSTGRES_DB=dataflow
POSTGRES_USER=dataflow
POSTGRES_PASSWORD=changeme
POSTGRES_DSN=postgresql+psycopg://dataflow:changeme@localhost:5432/dataflow

# minio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dataflow

# limites operacionais
MAX_FILE_SIZE_MB=100
EXECUTION_TIMEOUT_MINUTES=30

# redis / celery
REDIS_URL=redis://localhost:6379/0
# processos do worker, cada um sobe uma JVM: mais processos pedem mais memoria
WORKER_CONCURRENCY=2
# reconciler: espera e intervalo. pra demo de requisicao perdida use 1 e 30
RECONCILE_AFTER_MINUTES=10
RECONCILE_INTERVAL_SECONDS=300

# "development" habilita /dev/*. em producao use "production" (default)
ENV=development
